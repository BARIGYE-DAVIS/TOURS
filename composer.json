{
    "name": "barigye-davis/nssf-uganda-dashboard",
    "description": "Professional NSSF Uganda Dashboard with PHP, JavaScript, Bootstrap & Chart.js",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "BARIGYE-DAVIS",
            "email": "admin@nssf-uganda.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "phpmailer/phpmailer": "^6.8",
        "tecnickcom/tcpdf": "^6.6",
        "phpoffice/phpspreadsheet": "^1.29",
        "intervention/image": "^2.7",
        "nesbot/carbon": "^2.72",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "classes/",
            "App\\Controllers\\": "controllers/",
            "App\\Models\\": "models/",
            "App\\Utils\\": "utils/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"copy('config/app.example.php', 'config/app.php');\""
        ]
    }
}