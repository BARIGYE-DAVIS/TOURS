# Environment Configuration
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nssf-uganda.com
APP_KEY=base64:your-32-character-secret-key-here

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nssf_uganda
DB_USERNAME=nssf_user
DB_PASSWORD=your-secure-password

# Email Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@nssf-uganda.com
MAIL_FROM_NAME="NSSF Uganda"

# Redis Configuration (Optional)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMS Configuration (Optional)
SMS_PROVIDER=twilio
TWILIO_SID=your-twilio-sid
TWILIO_TOKEN=your-twilio-token
TWILIO_FROM=+1234567890

# Security Configuration
PASSWORD_SALT=your-password-salt-here
CSRF_TOKEN_NAME=_token

# Logging Configuration
LOG_LEVEL=error

# Feature Flags
FEATURE_SMS=true
FEATURE_EMAIL_CAMPAIGNS=true
FEATURE_ANALYTICS=true
FEATURE_AI_SEGMENTATION=true
FEATURE_FRAUD_DETECTION=true
FEATURE_MOBILE_API=true

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=assets/uploads/

# API Configuration
API_RATE_LIMIT=1000
API_TIMEOUT=30

# Cache Configuration
CACHE_DRIVER=file
CACHE_LIFETIME=3600

# Database Query Logging
DB_LOG_QUERIES=false